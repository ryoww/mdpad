{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mdpad のメインウィンドウに必要な最小権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
